# NexaClip 后端配置模板（复制为 app/.env 后按需填写）

# 服务端口
BACK_END_PORT=7860

# 数据库：默认 sqlite（库与成品都在本地 data/）；用 postgres 把 DB_TYPE 改成 postgres 并填下面几行
DB_TYPE=sqlite
# DB_TYPE=postgres
# PG_HOST=
# PG_PORT=5432
# PG_USER=postgres
# PG_PASSWORD=
# PG_DATABASE=nexaclip

# JWT 签名密钥：生产务必换成固定随机串（用默认值会每次重启全员掉线）
JWT_SECRET_KEY=secret_key

# 前端地址：重置密码邮件里的链接前缀
USER_FE_URL=http://localhost:5173

# 默认管理员：首次启动自动创建，可直接登录；生产务必改邮箱和密码
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NAME=admin
SUPER_ADMIN_PASSWORD=change-me

# 邮件服务：注册验证码 / 找回密码用；不填则这两个功能不可用
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SENDER=
LOGO_NAME=NexaClip

# ============ 下载引擎 ============

# cookies：浏览器扩展「Get cookies.txt LOCALLY」登录目标站后导出 Netscape txt，存到本地
YOUTUBE_COOKIES=data/cookies/www.youtube.com_cookies.txt
# 抖音：cookies 的浏览器指纹必须与 conf/conf.yaml 对齐；改前先 chrome://version 看真实 UA/版本
DOUYIN_COOKIES=data/cookies/www.douyin.com_cookies.txt
BILIBILI_COOKIES=data/cookies/www.bilibili.com_cookies.txt
# 出口代理：服务器 IP 被 YouTube 拦时填，留空=直连
HTTP_PROXY_URL=

# ========= AI 能力（千流云，一把 key 通用 chat / embedding / rerank / ASR / TTS）=========
# 在 https://console.qlcloud.top/keys 创建；模型档位与网关地址写死在 config.py
QL_KEY=

# 订阅每轮枚举的最新条数
SUB_ENUM_LIMIT=10
